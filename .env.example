# Puerto HTTP del backend NestJS
PORT=3001

# Entorno: development | production | test
# En producciÃ³n se exige DB_HOST no-local y DB_PASSWORD rellenado.
NODE_ENV=development

# Secreto para firmar tokens de sesiÃ³n (mÃ­nimo 32 caracteres aleatorios).
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Clave interna privada compartida con el BFF; configura el mismo valor en ambos.
INTERNAL_API_KEY=replace-with-another-random-key-at-least-32-characters

# RecuperaciÃ³n de contraseÃ±a por correo mediante Resend.
# Configura un dominio verificado en Resend y usa una direcciÃ³n de ese dominio.
RESEND_API_KEY=re_xxxxxxxxx
PASSWORD_RESET_FROM=CHUCK's Web <no-reply@tu-dominio.com>
FRONTEND_URL=http://localhost:5177

# Google Calendar (OAuth). Crea credenciales OAuth 2.0 en Google Cloud Console
# y registra exactamente GOOGLE_REDIRECT_URI como URI de redireccionamiento.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:3000/calendar/google/callback
# Calendario a importar: "primary" o el ID de un calendario de Google.
GOOGLE_CALENDAR_ID=primary
# Zona horaria usada cuando Google entrega fechas en UTC.
GOOGLE_CALENDAR_TIMEZONE=America/Santiago

# --- PostgreSQL (partes sueltas) ---
# Tienen prioridad sobre DATABASE_URL; si prefieres la URL completa,
# deja estas variables vacÃ­as y define solo DATABASE_URL.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=chucks_web
# TLS con el servidor PG: disable | require | verify-full
# (usa require/verify-full en producciÃ³n)
DB_SSL=disable

# --- URL completa (opcional si DB_* estÃ¡ definido) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chucks_web?schema=public

# OPCIONAL: directorio perfil Chrome para Puppeteer (evita cookies/login conflictos)
# SHOP_CHROME_PROFILE=C:/Users/USER/AppData/Local/Google/Chrome/User Data/chucks-web-buyee-profile
