generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Task {
  id        String   @id @default(cuid())
  title     String
  project   String   @default("General")
  due       String   @default("Hoy")
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Collection {
  id          Int                @id @default(autoincrement())
  name        String             @unique
  description String             @default("")
  type        String             @default("generic")
  position    Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  columns     CollectionColumn[]
  items       CollectionItem[]
}

model CollectionColumn {
  id           Int                @id @default(autoincrement())
  collectionId Int
  collection   Collection         @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  name         String
  label        String
  type         String             @default("string")
  required     Boolean            @default(false)
  position     Int                @default(0)

  @@unique([collectionId, name])
  @@index([collectionId])
}

model CollectionItem {
  id           Int        @id @default(autoincrement())
  collectionId Int
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  name         String
  values       Json       @default("{}")
  imageUrl     String?
  tags         String[]   @default([])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([collectionId])
}

model WishlistItem {
  id           Int            @id @default(autoincrement())
  name         String
  manufacturer String         @default("")
  year         Int?
  imageUrl     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  prices       WishlistPrice[]
}

model WishlistPrice {
  id         Int           @id @default(autoincrement())
  wishlistId Int
  wishlist   WishlistItem  @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  store      String
  url        String
  price      Float?
  currency   String?
  checkedAt  DateTime?
  error      String?

  @@unique([wishlistId, url])
  @@index([wishlistId])
}
